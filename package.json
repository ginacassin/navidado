{
  "name": "navidado",
  "version": "1.0.0",
  "private": true,
  "description": "Navidado — el juego de regalos con dado para Navidad (un solo móvil o sala tipo Jackbox).",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server/index.js",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "sirv": "^3.0.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/nunito": "^5.1.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/three": "^0.171.0",
    "concurrently": "^9.1.0",
    "esbuild": "^0.24.0",
    "qrcode": "^1.5.4",
    "socket.io-client": "^4.8.1",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.0",
    "three": "^0.171.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
